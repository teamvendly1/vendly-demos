  "reviews": [
    {
      "name": "Charles Gandy",
      "text": "Reed and his team of professionals gave me a roof superior in quality and a very memorable experience. From start to finish they were very respectful and thoughtful. The customer service they delivered was hands down the best I've ever experienced with a contractor. Thank you for the beautiful roof and chimney and thank you for your service. #MAVEN4QUALITYROOFS",
      "body": "Reed and his team of professionals gave me a roof superior in quality and a very memorable experience. From start to finish they were very respectful and thoughtful. The customer service they delivered was hands down the best I've ever experienced with a contractor. Thank you for the beautiful roof and chimney and thank you for your service. #MAVEN4QUALITYROOFS",
      "rating": null,
      "date": "",
